            "After example 1: ['Sunny', 'Warm', 'Normal', 'Strong']\n",
            "After example 2: ['Sunny', 'Warm', '?', 'Strong']\n",
            "After example 4: ['Sunny', 'Warm', '?', '?']\n",
            "\n",
            "Final Most Specific Hypothesis:\n",
            "['Sunny', 'Warm', '?', '?']\n"
          ]
        }
      ],
      "source": [
        "data = [\n",
        "    [\"Sunny\", \"Warm\", \"Normal\", \"Strong\", \"Yes\"],\n",
        "    [\"Sunny\", \"Warm\", \"High\", \"Strong\", \"Yes\"],\n",
        "    [\"Rainy\", \"Cold\", \"High\", \"Strong\", \"No\"],\n",
        "    [\"Sunny\", \"Warm\", \"High\", \"Weak\", \"Yes\"]\n",
        "]\n",
        "\n",
        "# Initialize hypothesis\n",
        "h = [\"Ø\", \"Ø\", \"Ø\", \"Ø\"]\n",
        "\n",
        "# Find-S algorithm\n",
        "for i, example in enumerate(data):\n",
        "    if example[-1] == \"Yes\":\n",
        "        for j in range(len(h)):\n",
        "            if h[j] == \"Ø\":\n",
        "                h[j] = example[j]\n",
        "            elif h[j] != example[j]:\n",
        "                h[j] = \"?\"\n",
        "\n",
        "        print(f\"After example {i+1}: {h}\")\n",
        "\n",
        "print(\"\\nFinal Most Specific Hypothesis:\")\n",
        "print(h)\n"
      ]
    }
