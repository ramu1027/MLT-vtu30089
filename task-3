        "\n",
        "import java.util.Arrays;\n",
        "\n",
        "public class PCAExample {\n",
        "\n",
        "    public static void main(String[] args) {\n",
        "\n",
        "        // Dataset: 5 samples and 4 features\n",
        "        double[][] data = {\n",
        "            {2.5, 2.4, 1.2, 0.8},\n",
        "            {0.5, 0.7, 0.3, 0.2},\n",
        "            {2.2, 2.9, 1.5, 1.0},\n",
        "            {1.9, 2.2, 1.0, 0.7},\n",
        "            {3.1, 3.0, 1.8, 1.2}\n",
        "        };\n",
        "\n",
        "        int rows = data.length;\n",
        "        int cols = data[0].length;\n",
        "        int components = 2;\n",
        "\n",
        "        // Step 1: Calculate the mean of each feature\n",
        "        double[] mean = new double[cols];\n",
        "\n",
        "        for (int j = 0; j < cols; j++) {\n",
        "            for (int i = 0; i < rows; i++) {\n",
        "                mean[j] += data[i][j];\n",
        "            }\n",
        "            mean[j] /= rows;\n",
        "        }\n",
        "\n",
        "        // Step 2: Center the dataset\n",
        "        double[][] centered = new double[rows][cols];\n",
        "\n",
        "        for (int i = 0; i < rows; i++) {\n",
        "            for (int j = 0; j < cols; j++) {\n",
        "                centered[i][j] = data[i][j] - mean[j];\n",
        "            }\n",
        "        }\n",
        "\n",
        "        // Step 3: Calculate covariance matrix\n",
        "        double[][] cov = new double[cols][cols];\n",
        "\n",
        "        for (int i = 0; i < cols; i++) {\n",
        "            for (int j = 0; j < cols; j++) {\n",
        "                for (int k = 0; k < rows; k++) {\n",
        "                    cov[i][j] += centered[k][i] * centered[k][j];\n",
        "                }\n",
        "                cov[i][j] /= (rows - 1);\n",
        "            }\n",
        "        }\n",
        "\n",
        "        // Step 4: Find principal components using power iteration\n",
        "        double[][] eigenvectors = new double[components][cols];\n",
        "        double[][] matrix = new double[cols][cols];\n",
        "\n",
        "        for (int i = 0; i < cols; i++) {\n",
        "            matrix[i] = cov[i].clone();\n",
        "        }\n",
        "\n",
        "        for (int c = 0; c < components; c++) {\n",
        "            double[] v = new double[cols];\n",
        "            Arrays.fill(v, 1.0);\n",
        "\n",
        "            for (int iter = 0; iter < 1000; iter++) {\n",
        "                double[] next = new double[cols];\n",
        "\n",
        "                for (int i = 0; i < cols; i++) {\n",
        "                    for (int j = 0; j < cols; j++) {\n",
        "                        next[i] += matrix[i][j] * v[j];\n",
        "                    }\n",
        "                }\n",
        "\n",
        "                double norm = 0;\n",
        "                for (double x : next) {\n",
        "                    norm += x * x;\n",
        "                }\n",
        "                norm = Math.sqrt(norm);\n",
        "\n",
        "                if (norm < 1e-12) {\n",
        "                    break;\n",
        "                }\n",
        "\n",
        "                for (int i = 0; i < cols; i++) {\n",
        "                    next[i] /= norm;\n",
        "                }\n",
        "\n",
        "                v = next;\n",
        "            }\n",
        "\n",
        "            eigenvectors[c] = v.clone();\n",
        "\n",
        "            // Eigenvalue\n",
        "            double eigenvalue = 0;\n",
        "            for (int i = 0; i < cols; i++) {\n",
        "                for (int j = 0; j < cols; j++) {\n",
        "                    eigenvalue += v[i] * cov[i][j] * v[j];\n",
        "                }\n",
        "            }\n",
        "\n",
        "            // Deflate matrix to find the next component\n",
        "            for (int i = 0; i < cols; i++) {\n",
        "                for (int j = 0; j < cols; j++) {\n",
        "                    matrix[i][j] -= eigenvalue * v[i] * v[j];\n",
        "                }\n",
        "            }\n",
        "        }\n",
        "\n",
        "        // Step 5: Project centered data onto principal components\n",
        "        double[][] reduced = new double[rows][components];\n",
        "\n",
        "        for (int i = 0; i < rows; i++) {\n",
        "            for (int c = 0; c < components; c++) {\n",
        "                for (int j = 0; j < cols; j++) {\n",
        "                    reduced[i][c] += centered[i][j]\n",
        "                            * eigenvectors[c][j];\n",
        "                }\n",
        "            }\n",
        "        }\n",
        "\n",
        "        // Step 6: Display reduced dataset\n",
        "        System.out.println(\"Original Dataset: \"\n",
        "                + rows + \" samples, \" + cols + \" features\");\n",
        "\n",
        "        System.out.println(\"\\nDataset after PCA (2 components):\");\n",
        "\n",
        "        for (double[] row : reduced) {\n",
        "            System.out.printf(\"%.4f  %.4f%n\", row[0], row[1]);\n",
        "        }\n",
        "    }\n",
        "}\n"
      ]
    }
  ]
}